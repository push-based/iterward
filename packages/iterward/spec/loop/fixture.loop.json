{
  "name": "fixture",
  "inputs": { "required": ["subject"], "optional": ["design"] },
  "preflight": "./hooks.mts#preflight",
  "questions": { "file": "Q-{n}.md", "onAnswer": "./hooks.mts#onAnswer" },
  "artifacts": {
    "notes": { "file": "notes.md", "guard": "./hooks.mts#guard" },
    "plan": { "file": "plan.md", "guard": "./hooks.mts#planGuard" },
    "diff": { "file": "diff.md" },
    "build-report": { "file": "build.{attempt}.report.md", "guard": "./hooks.mts#guard" },
    "verify-report": { "file": "verify-build.{attempt}.report.md", "guard": "./hooks.mts#guard" }
  },
  "steps": {
    "discovery": { "agent": "scout", "writes": "notes", "outcomes": ["ok", "blocked"] },
    "supplement": { "agent": "scout", "writes": "notes", "outcomes": ["ok", "blocked"] },
    "draft": { "agent": "planner", "writes": "plan", "outcomes": ["ok", "needs-decisions", "needs-evidence", "blocked"] },
    "revision": { "agent": "planner", "writes": "plan", "outcomes": ["ok", "needs-decisions", "needs-evidence", "blocked"] },
    "build": { "agent": "builder", "writes": "build-report", "outcomes": ["ok", "plan-invalidated", "blocked"] },
    "verify-build": { "agent": "verifier", "writes": "verify-report", "outcomes": ["pass", "fail", "plan-invalidated", "blocked"], "onEnter": "./hooks.mts#onEnter" }
  },
  "gates": { "gate": { "label": "Gate", "freezes": ["notes", "plan", "diff"] } },
  "stops": { "release": { "onEnter": "./hooks.mts#onEnter" } },
  "machine": {
    "start": "discovery",
    "discovery.ok": "draft",
    "supplement.ok": "revision",
    "draft.ok": "gate",
    "revision.ok": "gate",
    "draft.needs-decisions": { "ask": "revision" },
    "revision.needs-decisions": { "ask": "revision" },
    "draft.needs-evidence": "supplement",
    "revision.needs-evidence": "supplement",
    "gate.approve": "build",
    "gate.reject": "revision",
    "build.ok": "verify-build",
    "verify-build.pass": "release",
    "verify-build.fail": "build",
    "*.blocked": "park",
    "*.plan-invalidated": "park"
  },
  "human": { "build": ["revision"], "verify-build": ["revision", "build"], "release": ["revision", "build"] },
  "limits": { "opens": 3 }
}
