{
  "name": "fds-l2",
  "inputs": { "required": ["component"], "optional": ["design"] },
  "questions": "RFC-{n}.md",
  "preflight": { "module": "./hooks.mts", "export": "preflight" },
  "result": { "module": "./hooks.mts", "export": "readResult" },
  "onAnswer": { "module": "./hooks.mts", "export": "onAnswer" },
  "artifacts": {
    "discovery": { "file": "EVID-discovery.md", "guard": { "module": "./hooks.mts", "export": "guard" } },
    "plan": { "file": "plan.md", "guard": { "module": "./hooks.mts", "export": "guard" } },
    "diff": { "file": "diff.md" },
    "verdict": { "file": "verdict.{attempt}.md", "guard": { "module": "./hooks.mts", "export": "guard" } },
    "build-report": { "file": "build.{attempt}.report.md", "guard": { "module": "./hooks.mts", "export": "guard" } },
    "verify-report": { "file": "verify-build.{attempt}.report.md", "guard": { "module": "./hooks.mts", "export": "guard" } }
  },
  "stages": [
    {
      "plan": "plan",
      "route": { "module": "./hooks.mts", "export": "route" },
      "dispatches": {
        "discovery": {
          "agent": "l2-discovery", "artifact": "discovery",
          "message": "Discovery mode. Component: {component}. Design: {design}. Run: {runPath}.",
          "outcomes": { "ok": { "route": true }, "blocked": { "park": true } }
        },
        "draft": {
          "agent": "l2-planner", "artifact": "plan",
          "message": "Draft mode. Run: {runPath}.",
          "outcomes": { "ok": { "route": true }, "needs-decisions": { "ask": true }, "blocked": { "park": true } }
        },
        "revision": {
          "agent": "l2-planner", "artifact": "plan",
          "message": "Revision mode. Run: {runPath}. Note: '{note}'.",
          "outcomes": { "ok": { "route": true }, "needs-decisions": { "ask": true }, "blocked": { "park": true } }
        },
        "judge": {
          "agent": "l2-judge", "artifact": "verdict",
          "message": "Judge dispute {dispute}. Run: {runPath}. Verdict: {document}.",
          "outcomes": { "upheld": { "route": true }, "rejected": { "route": true }, "unsure": { "route": true } }
        }
      }
    },
    { "gate": "gate1", "label": "Gate 1", "freezes": ["discovery", "plan", "diff"], "summary": { "module": "./hooks.mts", "export": "gateSummary" } },
    {
      "work": "build",
      "dispatch": {
        "agent": "l2-builder", "artifact": "build-report",
        "message": "Run: {runPath}. Report: {document}. Note: '{note}'.",
        "outcomes": { "plan-invalidated": { "park": true } }
      }
    },
    {
      "verify": "verify-build",
      "dispatch": {
        "agent": "l2-verifier", "artifact": "verify-report",
        "message": "Run: {runPath}. Report: {document}.",
        "outcomes": { "plan-invalidated": { "park": true } }
      },
      "maxFailed": 3
    },
    { "stop": "integrate" }
  ],
  "validators": {
    "verify-build": { "module": "./hooks.mts", "export": "validator" },
    "integrate": { "module": "./hooks.mts", "export": "validator" }
  },
  "limits": { "dispatchMinutes": 30 }
}
